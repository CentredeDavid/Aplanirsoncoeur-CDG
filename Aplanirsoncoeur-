<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplanissement de ton Cœur - Questionnaire & Bilan</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        davidBlue: '#0489cc',
                        davidBlueDark: '#0369a1',
                        davidBlueLight: '#e0f2fe',
                        davidRed: '#db5441',
                        davidRedDark: '#b91c1c',
                        davidRedLight: '#fef2f2',
                        navyDark: '#0f172a',
                        slateBg: '#f8fafc'
                    }
                }
            }
        }
    </script>

    <style>
        .chart-box {
            position: relative;
            width: 100%;
            max-width: 100%;
            margin-left: auto;
            margin-right: auto;
            height: 320px;
            max-height: 400px;
        }
        @media (min-width: 768px) {
            .chart-box {
                height: 380px;
            }
        }
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            .print-break-inside-avoid {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body class="bg-slateBg text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <header class="bg-gradient-to-r from-slate-900 via-[#0489cc] to-slate-900 text-white shadow-xl no-print border-b-4 border-davidRed">
        <div class="max-w-6xl mx-auto px-4 py-8 text-center sm:text-left flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
                <div class="inline-flex items-center space-x-2 bg-white/10 border border-white/20 px-3 py-1 rounded-full text-white text-xs uppercase font-bold tracking-wider mb-2">
                    <span class="text-davidRed font-extrabold">🫀</span>
                    <span>Auto-Évaluation Spirituelle • Centre de DAVID</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
                    Aplanissement de ton cœur
                </h1>
                <p class="text-sky-100 text-sm sm:text-base mt-2 max-w-2xl font-light">
                    Il est impossible de bâtir sur un terrain irrégulier, il faut absolument que ce dernier soit aplani / mis à niveau. Pour nous cela veut dire que nous devons évacuer les excroissances de nos cœurs.
                </p>
            </div>
            
            <div class="bg-slate-900/90 p-4 rounded-xl border border-sky-400/30 w-full sm:w-auto text-left min-w-[260px] shadow-lg">
                <label class="block text-xs font-semibold text-sky-300 uppercase tracking-wider mb-1">Participant(e) :</label>
                <input type="text" id="participantName" placeholder="Ton Nom / Prénom" class="w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-davidBlue mb-2" oninput="updateRecapMeta()">
                
                <label class="block text-xs font-semibold text-sky-300 uppercase tracking-wider mb-1">Date du bilan :</label>
                <input type="date" id="participantDate" class="w-full bg-slate-800 border border-slate-600 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-davidBlue" oninput="updateRecapMeta()">
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8 flex-grow space-y-10 w-full">

        <section class="no-print">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
                        <span class="text-davidRed">📋</span>
                        <span>Formulaire d'Évaluation des Excroissances</span>
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-600">Remplis chaque section avec sincérité pour observer l'état réel de ton terrain intérieur.</p>
                </div>
                <button onclick="resetForm()" class="text-xs bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1">
                    <span>🔄</span>
                    <span>Réinitialiser</span>
                </button>
            </div>

            <div id="formContainer" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            </div>
        </section>

        <section class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 sm:p-8 no-print">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                        <span class="text-davidBlue">📊</span>
                        <span>Analyse Graphique du Terrain</span>
                    </h2>
                    <p class="text-xs text-slate-600">Visualisation dynamique des niveaux d'excroissances relevés.</p>
                </div>
                <div class="flex items-center space-x-2 bg-slate-100 p-1 rounded-xl">
                    <button id="btnChartBar" onclick="switchChartType('bar')" class="px-3 py-1 text-xs font-bold rounded-lg bg-davidBlue text-white shadow-sm transition-all">
                        Barres
                    </button>
                    <button id="btnChartRadar" onclick="switchChartType('radar')" class="px-3 py-1 text-xs font-bold rounded-lg text-slate-600 hover:text-slate-900 transition-all">
                        Radar
                    </button>
                </div>
            </div>

            <div class="chart-box">
                <canvas id="liveChart"></canvas>
            </div>
        </section>

        <section id="pdfWrapper" class="bg-white rounded-2xl shadow-xl border border-slate-200 p-6 sm:p-10 space-y-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
                <div>
                    <div class="inline-block bg-sky-100 text-davidBlueDark text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wider mb-1">
                        Centre de DAVID • Synthèse Finale
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
                        Bilan d'Aplanissement du Cœur
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">
                        Participant : <span id="recapName" class="font-semibold text-slate-800">Non renseigné</span> | Date : <span id="recapDate" class="font-semibold text-slate-800">Aujourd'hui</span>
                    </p>
                </div>

                <div class="flex items-center space-x-3 no-print w-full sm:w-auto">
                    <button onclick="downloadPDF()" class="flex-1 sm:flex-none inline-flex items-center justify-center space-x-2 bg-davidRed hover:bg-davidRedDark text-white font-bold text-sm px-5 py-2.5 rounded-xl transition-all shadow-md">
                        <span>📥</span>
                        <span>Télécharger le PDF</span>
                    </button>
                    <button onclick="window.print()" class="inline-flex items-center justify-center space-x-2 bg-davidBlue hover:bg-davidBlueDark text-white font-bold text-sm px-4 py-2.5 rounded-xl transition-all shadow-md">
                        <span>🖨️</span>
                        <span>Imprimer</span>
                    </button>
                </div>
            </div>

            <div class="bg-sky-50 border-l-4 border-davidBlue p-4 rounded-r-xl">
                <p class="text-xs sm:text-sm text-slate-800 italic">
                    « Il est impossible de bâtir sur un terrain irrégulier, il faut absolument que ce dernier soit aplani / mis à niveau. Pour nous cela veut dire que nous devons évacuer les excroissances de nos cœurs. »
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-4">
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-center">
                    <div class="text-xs text-slate-500 font-semibold uppercase">Moyenne d'Excroissance</div>
                    <div id="statAvg" class="text-3xl font-black text-davidBlue mt-1">0%</div>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-center">
                    <div class="text-xs text-slate-500 font-semibold uppercase">Excroissance Majeure</div>
                    <div id="statMax" class="text-base font-bold text-davidRed mt-2 truncate">Aucune</div>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-center">
                    <div class="text-xs text-slate-500 font-semibold uppercase">Niveau d'Urgence</div>
                    <div id="statStatus" class="text-base font-bold text-teal-600 mt-2">Terrain Stable</div>
                </div>
            </div>

            <div id="recapChartContainer" class="chart-box my-6 print-break-inside-avoid">
                <canvas id="recapChart"></canvas>
            </div>

            <div class="overflow-x-auto my-6">
                <table class="w-full text-left border-collapse border border-slate-200 text-xs sm:text-sm">
                    <thead>
                        <tr class="bg-slate-900 text-white">
                            <th class="p-3 border border-slate-700 w-1/4 bg-[#0489cc]">À supprimer du cœur</th>
                            <th class="p-3 border border-slate-700 w-1/6 text-center bg-[#0489cc]">Niveau (%)</th>
                            <th class="p-3 border border-slate-700 w-7/24 bg-[#0489cc]">Pourquoi cela existe en toi ?</th>
                            <th class="p-3 border border-slate-700 w-7/24 bg-[#0489cc]">Que faire pour t'en séparer ?</th>
                        </tr>
                    </thead>
                    <tbody id="recapTableBody">
                    </tbody>
                </table>
            </div>

            <div class="pt-6 border-t border-slate-200 text-center text-xs text-slate-400">
                Centre de DAVID • Fiche d'engagement et de restauration spirituelle - Bâtir sur un fondement solide.
            </div>
        </section>

    </main>

    <footer class="bg-slate-900 text-slate-400 py-6 text-center text-xs border-t-2 border-davidRed no-print">
        <div class="max-w-6xl mx-auto px-4">
            Aplanissement de ton Cœur • Centre de DAVID
        </div>
    </footer>

    <script>
        const traits = [
            {
                id: 'hypocrisie',
                title: 'L\'hypocrisie',
                desc: 'Le fait de déguiser son véritable caractère ou ses sentiments.'
            },
            {
                id: 'duplicite',
                title: 'La duplicité',
                desc: 'Le fait de jouer un double jeu, d\'avoir deux attitudes différentes.'
            },
            {
                id: 'faussete',
                title: 'La fausseté',
                desc: 'Le manque de sincérité ou de franchise.'
            },
            {
                id: 'pharisianisme',
                title: 'Le pharisaïsme',
                desc: 'Une dévotion purement extérieure et formaliste, sans foi réelle.'
            },
            {
                id: 'rancoeurs',
                title: 'Les rancœurs',
                desc: 'Ressentiment tenace conservé envers autrui.'
            },
            {
                id: 'orgueil',
                title: 'L\'orgueil',
                desc: 'Opinion très élevée de soi-même, autosuffisance.'
            }
        ];

        let formData = {
            hypocrisie: { percent: 20, why: '', action: '' },
            duplicite: { percent: 15, why: '', action: '' },
            faussete: { percent: 10, why: '', action: '' },
            pharisianisme: { percent: 25, why: '', action: '' },
            rancoeurs: { percent: 30, why: '', action: '' },
            orgueil: { percent: 40, why: '', action: '' }
        };

        let currentChartType = 'bar';
        let liveChartInstance = null;
        let recapChartInstance = null;

        function wrapLabel(str, maxChars = 16) {
            if (!str) return '';
            if (str.length <= maxChars) return str;
            const words = str.split(' ');
            const lines = [];
            let currentLine = '';

            words.forEach(word => {
                if ((currentLine + ' ' + word).trim().length <= maxChars) {
                    currentLine = (currentLine + ' ' + word).trim();
                } else {
                    if (currentLine) lines.push(currentLine);
                    currentLine = word;
                }
            });
            if (currentLine) lines.push(currentLine);
            return lines;
        }

        const customTooltipConfig = {
            callbacks: {
                title: function(tooltipItems) {
                    const item = tooltipItems[0];
                    let label = item.chart.data.labels[item.dataIndex];
                    if (Array.isArray(label)) {
                        return label.join(' ');
                    } else {
                        return label;
                    }
                }
            }
        };

        function renderFormFields() {
            const container = document.getElementById('formContainer');
            container.innerHTML = '';

            traits.forEach(trait => {
                const data = formData[trait.id];
                const card = document.createElement('div');
                card.className = "bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4";
                
                card.innerHTML = `
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div>
                            <h3 class="font-bold text-slate-900 text-base">${trait.title}</h3>
                            <p class="text-xs text-slate-500">${trait.desc}</p>
                        </div>
                        <span id="badge-${trait.id}" class="text-xs font-black px-2.5 py-1 rounded-full bg-sky-100 text-davidBlue">
                            ${data.percent}%
                        </span>
                    </div>

                    <div>
                        <div class="flex justify-between items-center text-xs font-medium text-slate-700 mb-1">
                            <span>Niveau existant en toi :</span>
                            <span id="val-${trait.id}" class="font-bold text-slate-900">${data.percent}%</span>
                        </div>
                        <input type="range" min="0" max="100" value="${data.percent}" 
                            class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-davidBlue"
                            oninput="updatePercent('${trait.id}', this.value)">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Pourquoi penses-tu que cela existe en toi ?</label>
                        <textarea rows="2" 
                            placeholder="Racines, peurs, habitudes, passé..." 
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs text-slate-800 focus:outline-none focus:bg-white focus:border-davidBlue transition-colors"
                            oninput="updateText('${trait.id}', 'why', this.value)">${data.why}</textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Que penses-tu faire pour t'en séparer ?</label>
                        <textarea rows="2" 
                            placeholder="Actions concrètes, prière, redevabilité..." 
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs text-slate-800 focus:outline-none focus:bg-white focus:border-davidBlue transition-colors"
                            oninput="updateText('${trait.id}', 'action', this.value)">${data.action}</textarea>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function updatePercent(id, val) {
            formData[id].percent = parseInt(val);
            document.getElementById(`val-${id}`).innerText = val + '%';
            document.getElementById(`badge-${id}`).innerText = val + '%';
            
            const badge = document.getElementById(`badge-${id}`);
            if (val > 60) {
                badge.className = "text-xs font-black px-2.5 py-1 rounded-full bg-red-100 text-davidRed";
            } else if (val > 30) {
                badge.className = "text-xs font-black px-2.5 py-1 rounded-full bg-amber-100 text-amber-700";
            } else {
                badge.className = "text-xs font-black px-2.5 py-1 rounded-full bg-sky-100 text-davidBlue";
            }

            refreshChartsAndRecap();
        }

        function updateText(id, field, val) {
            formData[id][field] = val;
            renderRecapTable();
        }

        function updateRecapMeta() {
            const name = document.getElementById('participantName').value;
            const date = document.getElementById('participantDate').value;
            document.getElementById('recapName').innerText = name.trim() !== '' ? name : 'Non renseigné';
            document.getElementById('recapDate').innerText = date !== '' ? date : 'Aujourd\'hui';
        }

        function switchChartType(type) {
            currentChartType = type;
            const btnBar = document.getElementById('btnChartBar');
            const btnRadar = document.getElementById('btnChartRadar');

            if (type === 'bar') {
                btnBar.className = "px-3 py-1 text-xs font-bold rounded-lg bg-davidBlue text-white shadow-sm transition-all";
                btnRadar.className = "px-3 py-1 text-xs font-bold rounded-lg text-slate-600 hover:text-slate-900 transition-all";
            } else {
                btnRadar.className = "px-3 py-1 text-xs font-bold rounded-lg bg-davidBlue text-white shadow-sm transition-all";
                btnBar.className = "px-3 py-1 text-xs font-bold rounded-lg text-slate-600 hover:text-slate-900 transition-all";
            }

            initLiveChart();
        }

        function getChartLabels() {
            return traits.map(t => wrapLabel(t.title, 16));
        }

        function getChartDataValues() {
            return traits.map(t => formData[t.id].percent);
        }

        function initLiveChart() {
            const ctx = document.getElementById('liveChart').getContext('2d');
            if (liveChartInstance) {
                liveChartInstance.destroy();
            }

            const labels = getChartLabels();
            const dataVals = getChartDataValues();

            if (currentChartType === 'bar') {
                liveChartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Niveau existant (en %)',
                            data: dataVals,
                            backgroundColor: '#0489cc',
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: customTooltipConfig
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                ticks: {
                                    callback: function(val) { return val + '%'; }
                                }
                            }
                        }
                    }
                });
            } else {
                liveChartInstance = new Chart(ctx, {
                    type: 'radar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Niveau existant (en %)',
                            data: dataVals,
                            backgroundColor: 'rgba(4, 137, 204, 0.25)',
                            borderColor: '#0489cc',
                            pointBackgroundColor: '#db5441',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: customTooltipConfig
                        },
                        scales: {
                            r: {
                                beginAtZero: true,
                                max: 100,
                                ticks: { stepSize: 20 }
                            }
                        }
                    }
                });
            }
        }

        function initRecapChart() {
            const ctx = document.getElementById('recapChart').getContext('2d');
            if (recapChartInstance) {
                recapChartInstance.destroy();
            }

            const labels = getChartLabels();
            const dataVals = getChartDataValues();

            recapChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Excroissance (%)',
                        data: dataVals,
                        backgroundColor: '#db5441',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: customTooltipConfig
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                callback: function(val) { return val + '%'; }
                            }
                        }
                    }
                }
            });
        }

        function renderRecapTable() {
            const tbody = document.getElementById('recapTableBody');
            tbody.innerHTML = '';

            let totalPercent = 0;
            let maxVal = -1;
            let maxTraitTitle = 'Aucune';

            traits.forEach((trait, index) => {
                const data = formData[trait.id];
                totalPercent += data.percent;

                if (data.percent > maxVal) {
                    maxVal = data.percent;
                    maxTraitTitle = trait.title;
                }

                const tr = document.createElement('tr');
                tr.className = index % 2 === 0 ? 'bg-white' : 'bg-slate-50';

                let badgeClass = "text-davidBlue bg-sky-50";
                if (data.percent > 60) badgeClass = "text-davidRed bg-red-50 font-bold";
                else if (data.percent > 30) badgeClass = "text-amber-700 bg-amber-50 font-bold";

                tr.innerHTML = `
                    <td class="p-3 border border-slate-200 font-bold text-slate-900">${trait.title}</td>
                    <td class="p-3 border border-slate-200 text-center font-bold">
                        <span class="inline-block px-2 py-0.5 rounded ${badgeClass}">${data.percent}%</span>
                    </td>
                    <td class="p-3 border border-slate-200 text-slate-700 whitespace-pre-wrap">${data.why || '<em class="text-slate-400">Non renseigné</em>'}</td>
                    <td class="p-3 border border-slate-200 text-slate-700 whitespace-pre-wrap">${data.action || '<em class="text-slate-400">Non renseigné</em>'}</td>
                `;
                tbody.appendChild(tr);
            });

            const avg = Math.round(totalPercent / traits.length);
            document.getElementById('statAvg').innerText = avg + '%';
            document.getElementById('statMax').innerText = maxTraitTitle + ' (' + maxVal + '%)';

            const statusEl = document.getElementById('statStatus');
            if (avg > 50) {
                statusEl.innerText = "Aplanissement Urgent ⚠️";
                statusEl.className = "text-base font-bold text-davidRed mt-2";
            } else if (avg > 25) {
                statusEl.innerText = "Travail en cours 🚧";
                statusEl.className = "text-base font-bold text-amber-600 mt-2";
            } else {
                statusEl.innerText = "Terrain Sain & Stable ✨";
                statusEl.className = "text-base font-bold text-davidBlue mt-2";
            }
        }

        function refreshChartsAndRecap() {
            if (liveChartInstance) {
                liveChartInstance.data.datasets[0].data = getChartDataValues();
                liveChartInstance.update();
            }
            if (recapChartInstance) {
                recapChartInstance.data.datasets[0].data = getChartDataValues();
                recapChartInstance.update();
            }
            renderRecapTable();
        }

        function resetForm() {
            traits.forEach(t => {
                formData[t.id] = { percent: 0, why: '', action: '' };
            });
            renderFormFields();
            refreshChartsAndRecap();
        }

        async function downloadPDF() {
            const recapCanvas = document.getElementById('recapChart');
            const container = document.getElementById('recapChartContainer');
            
            const chartDataUrl = recapCanvas.toDataURL('image/png');
            const tempImg = document.createElement('img');
            tempImg.src = chartDataUrl;
            tempImg.style.width = '100%';
            tempImg.style.maxHeight = '320px';
            tempImg.style.objectFit = 'contain';
            tempImg.id = 'tempPdfChartImg';

            recapCanvas.style.display = 'none';
            container.appendChild(tempImg);

            const pdfElement = document.getElementById('pdfWrapper');
            const name = document.getElementById('participantName').value.trim() || 'Aplanissement_Coeur';
            
            const opt = {
                margin: [10, 8, 10, 8],
                filename: `Bilan_Aplanissement_Coeur_${name.replace(/\s+/g, '_')}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, logging: false, scrollY: 0 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            try {
                await html2pdf().set(opt).from(pdfElement).save();
            } catch (err) {
                console.error('Erreur PDF:', err);
            } finally {
                if (document.getElementById('tempPdfChartImg')) {
                    container.removeChild(tempImg);
                }
                recapCanvas.style.display = 'block';
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('participantDate').value = today;
            
            renderFormFields();
            renderRecapTable();
            initLiveChart();
            initRecapChart();
            updateRecapMeta();
        });
    </script>
</body>
</html>
